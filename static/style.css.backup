:root{--bg:#0a0c10;--panel:#11151b;--panel2:#151a22;--line:#252b34;--text:#f1f3f6;--muted:#87909d;--red:#ef3340;--yellow:#f2c14e;--soft:#ed3542;--green:#57d5a0;--font:'Inter',sans-serif;--display:'Barlow Condensed',sans-serif}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);font-size:13px}button,input{font:inherit}.app-shell{min-height:100vh;display:grid;grid-template-columns:220px minmax(0,1fr)}.sidebar{background:#0d1015;border-right:1px solid #20252d;padding:26px 17px;display:flex;flex-direction:column;min-height:100vh}.brand-mark{font-family:var(--display);font-size:30px;font-weight:800;letter-spacing:.5px;display:flex;align-items:center;gap:10px}.brand-slash{width:5px;height:27px;background:var(--red);transform:skew(-16deg)}.red{color:var(--red)}.sidebar-label{font-size:9px;letter-spacing:1.7px;color:#69727f;font-weight:700;margin:44px 9px 14px}.nav-item{padding:13px 11px;border-radius:7px;color:#b9c0ca;display:flex;align-items:center;gap:11px;margin-bottom:5px;font-size:12px}.nav-item.active{background:#25161b;color:#fff;border:1px solid #482128}.nav-icon{font-size:17px;color:var(--red);width:17px;text-align:center}.nav-item.muted{color:#747d89}.nav-item.muted .nav-icon{color:#69727f}.sidebar-bottom{margin-top:auto;border-top:1px solid #252a32;padding:18px 5px 0;display:flex;align-items:center;gap:10px;font-size:9px;letter-spacing:1px}.sidebar-bottom strong{display:block}.sidebar-bottom small{display:block;color:#78818e;font-size:10px;letter-spacing:0;margin-top:5px}.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);box-shadow:0 0 12px #57d5a055;display:inline-block;flex-shrink:0}.main{max-width:1500px;width:100%;padding:27px clamp(18px,3vw,46px) 18px;margin:0 auto}.topbar{display:flex;align-items:center;justify-content:space-between;padding-bottom:22px;border-bottom:1px solid var(--line)}.eyebrow,.section-kicker{font-size:9px;letter-spacing:1.8px;color:#87909c;font-weight:700}.slash{color:var(--red);padding:0 4px}.topbar h1{font-family:var(--display);font-size:35px;letter-spacing:1.4px;margin:4px 0 0;font-weight:800;line-height:1}.top-meta{display:flex;align-items:center;gap:16px}.live-pill{font-size:9px;letter-spacing:1px;border:1px solid #3b2a2e;border-radius:3px;padding:8px 10px;color:#c6cbd2}.live-pill i{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--red);margin-right:7px}.avatar{width:33px;height:33px;border-radius:50%;background:#262c35;display:grid;place-items:center;font-size:10px;font-weight:700}.intro-row{display:flex;justify-content:space-between;align-items:center;padding:24px 0 22px;overflow:hidden}.section-kicker{color:var(--red);margin:0 0 8px}.intro-row h2{font-family:var(--display);font-size:clamp(25px,3vw,35px);letter-spacing:.1px;margin:0 0 5px;font-weight:700}.subtext{color:var(--muted);margin:0;font-size:12px}.flag-art{height:80px;width:155px;position:relative;opacity:.7;display:flex;align-items:center;justify-content:flex-end;padding-right:8px}.flag-grid{position:absolute;inset:0;background-image:linear-gradient(45deg,#252b34 25%,transparent 25%),linear-gradient(-45deg,#252b34 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#252b34 75%),linear-gradient(-45deg,transparent 75%,#252b34 75%);background-size:20px 20px;background-position:0 0,0 10px,10px -10px,-10px 0;mask-image:linear-gradient(90deg,transparent,#000)}.flag-art span{font-family:var(--display);font-size:40px;font-weight:800;position:relative;color:#dce1e7}.workspace-grid{display:grid;grid-template-columns:minmax(280px,.82fr) minmax(0,1.6fr);gap:15px;align-items:stretch}.right-stack{display:grid;grid-template-rows:auto auto;gap:15px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:8px;min-width:0}.setup-panel{padding:19px 19px 15px}.panel-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-bottom:15px;border-bottom:1px solid #242a32}.panel-heading>div{display:flex;align-items:center;gap:10px}.panel-index{font-family:var(--display);font-weight:700;font-size:14px;color:var(--red)}.panel-heading h3{font-size:13px;margin:0;font-weight:600}.tiny-tag{font-size:8px;letter-spacing:1.2px;color:#8c95a1;border:1px solid #2c333d;padding:5px 7px;border-radius:3px;white-space:nowrap}.success-tag{color:var(--green);border-color:#24513f}.field-head{display:flex;justify-content:space-between;align-items:center;margin:20px 0 11px}.field-head label{font-size:11px;color:#c4cad2}.field-head strong{font-size:15px;font-variant-numeric:tabular-nums}.field-head small{font-size:8px;letter-spacing:1px;color:#828b98}.pit-head{margin-top:24px}input[type=range]{width:100%;accent-color:var(--red);cursor:pointer;height:4px}.range-labels{display:flex;justify-content:space-between;font-size:8px;letter-spacing:.7px;color:#68717d;margin-top:6px}.tyre-label{font-size:9px;letter-spacing:1.2px;color:#8b94a0;margin:26px 0 10px}.tyre-options{display:grid;gap:7px}.tyre-choice{display:flex;align-items:center;gap:9px;border:1px solid #2b313a;border-radius:5px;padding:8px 9px;font-size:11px;color:#d9dde3}.tyre-choice input{display:none}.tyre-choice small{margin-left:auto;color:#777f8b;font-size:8px;letter-spacing:.7px}.tyre-chip{display:grid;place-items:center;width:23px;height:23px;border-radius:4px;font-weight:800;font-size:11px}.soft{background:#4b1f26;color:#ff727a}.medium{background:#4d4020;color:#f7d46c}.hard{background:#333943;color:#d4d8df}.rule-toggle{display:flex;align-items:center;gap:10px;margin:19px 0 18px;cursor:pointer}.rule-toggle input{position:absolute;opacity:0}.toggle-ui{width:31px;height:18px;background:#353b45;border-radius:10px;position:relative;flex-shrink:0}.toggle-ui:after{content:"";position:absolute;width:12px;height:12px;left:3px;top:3px;background:#a4acb7;border-radius:50%;transition:.18s}.rule-toggle input:checked+.toggle-ui{background:#69232c}.rule-toggle input:checked+.toggle-ui:after{left:16px;background:#ff5c66}.rule-toggle b,.rule-toggle small{display:block;font-size:10px;font-weight:500}.rule-toggle small{font-size:9px;color:#818a96;margin-top:4px}.primary-button{width:100%;display:flex;justify-content:space-between;align-items:center;border:0;border-radius:4px;background:var(--red);color:white;padding:14px 15px;font-size:10px;font-weight:800;letter-spacing:1px;cursor:pointer;transition:background .15s,transform .15s}.primary-button:hover{background:#ff4754;transform:translateY(-1px)}.primary-button:disabled{opacity:.65;cursor:wait;transform:none}.button-arrow{font-size:17px}.fine-print{font-size:9px;color:#69727e;line-height:1.5;margin:10px 0 0}.hero-panel{padding:19px 19px 13px}.empty-state{min-height:210px;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:25px 10px}.empty-track{font-size:32px;color:#444c58;border:1px dashed #414955;border-radius:50%;width:58px;height:58px;display:grid;place-items:center;transform:rotate(-15deg);margin-bottom:9px}.empty-state h3{margin:0 0 7px;font-family:var(--display);font-size:21px}.empty-state p{max-width:300px;color:var(--muted);font-size:11px;line-height:1.6;margin:0}.hidden{display:none!important}.strategy-summary{display:flex;align-items:center;justify-content:space-between;padding:17px 0 15px}.metric-label{font-size:9px;letter-spacing:1.4px;color:#8b94a0;font-weight:700}.big-time{font-family:var(--display);font-size:42px;font-weight:700;letter-spacing:.5px;line-height:1.15;margin-top:3px;font-variant-numeric:tabular-nums}.metric-note{font-size:10px;color:#818a96;margin-top:4px}.stop-count{width:69px;height:69px;border:1px solid #3c3034;background:#1b151a;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column}.stop-count span{font-family:var(--display);font-size:28px;font-weight:700}.stop-count small{font-size:8px;letter-spacing:.8px;color:#a8afb9}.stint-track{display:flex;gap:5px;min-height:43px}.stint{position:relative;min-width:0;border-radius:3px;padding:8px 9px;overflow:hidden;background:#202630;border-top:3px solid var(--stint-color)}.stint b{font-size:10px;display:block;white-space:nowrap}.stint small{display:block;font-size:9px;color:#a1aab5;margin-top:4px;white-space:nowrap}.pit-details{display:flex;flex-wrap:wrap;gap:7px;margin:12px 0 14px}.pit-pill{font-size:9px;color:#c7cdd5;background:#1b2028;border:1px solid #2c333c;border-radius:3px;padding:6px 8px}.pit-pill b{color:#fff}.result-foot{border-top:1px solid #252b34;padding-top:11px;display:flex;justify-content:space-between;gap:10px;color:#7f8995;font-size:8px;letter-spacing:.6px}.result-foot .status-dot{margin-right:6px;width:5px;height:5px}.chart-panel{padding:17px 19px 12px}.chart-wrap{height:168px;margin-top:14px;position:relative}.chart-legend{display:flex;gap:15px;flex-wrap:wrap;margin-top:8px;color:#89929e;font-size:9px}.chart-legend span{display:flex;align-items:center;gap:6px}.legend-line{width:14px;height:3px;display:inline-block;border-radius:2px}.red-line{background:#ed3542}.yellow-line{background:#f2c14e}.grey-line{background:#b8c0ca}.legend-dash{width:14px;border-top:2px dashed #69727e;display:inline-block}.bottom-panel{margin-top:15px;padding:18px 19px 8px}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left;white-space:nowrap}th{font-size:8px;color:#7e8793;letter-spacing:1px;font-weight:700;padding:13px 12px;border-bottom:1px solid #272d36}td{font-size:10px;padding:13px 12px;border-bottom:1px solid #222831;color:#c5cbd3;font-variant-numeric:tabular-nums}tbody tr:last-child td{border-bottom:0}tbody tr.best-row{background:#1c171c}tbody tr.best-row td:first-child{color:var(--red)}.rank{font-family:var(--display);font-size:16px;font-weight:700}.compound-seq{font-weight:700;color:#f0f2f5}.table-empty{text-align:center;color:#727c88;padding:23px}.gap-best{color:var(--green)}footer{display:flex;justify-content:space-between;gap:10px;padding:20px 0 0;color:#5e6875;font-size:8px;letter-spacing:.8px}.toast{position:fixed;right:22px;bottom:22px;max-width:min(480px,calc(100vw - 44px));background:#1b2028;border:1px solid #5a3037;border-left:3px solid var(--red);padding:13px 16px;border-radius:5px;color:#f1f3f6;font-size:11px;line-height:1.5;box-shadow:0 10px 30px #0008;z-index:10}
@media(max-width:1050px){.app-shell{grid-template-columns:68px minmax(0,1fr)}.sidebar{padding:22px 10px;align-items:center}.brand-mark{font-size:0}.brand-mark>span:last-child{display:none}.brand-slash{height:26px}.sidebar-label{font-size:0;margin:35px 0 14px}.nav-item{font-size:0;justify-content:center;width:43px;padding:12px 0}.nav-icon{font-size:18px}.sidebar-bottom{justify-content:center;padding-top:16px}.sidebar-bottom>div:last-child{display:none}.workspace-grid{grid-template-columns:minmax(250px,.8fr) minmax(0,1.4fr)}}
@media(max-width:760px){.app-shell{display:block}.sidebar{display:none}.main{padding:18px 13px}.topbar h1{font-size:29px}.live-pill{font-size:0;padding:9px}.live-pill i{margin:0}.top-meta{gap:9px}.intro-row{padding:22px 0 17px}.flag-art{width:65px}.flag-art span{font-size:29px}.workspace-grid{grid-template-columns:1fr}.right-stack{grid-template-rows:auto auto}.setup-panel{order:0}.hero-panel{order:0}.chart-wrap{height:190px}.bottom-panel{padding:15px 12px 5px}.panel-heading h3{font-size:12px}.big-time{font-size:38px}.stint{padding:7px 6px}.stint b{font-size:9px}.stint small{font-size:8px}.result-foot{font-size:7px}footer{flex-direction:column;line-height:1.5}.topbar .eyebrow{font-size:8px;letter-spacing:1px}}

/* V2 cinematic car hero */
.car-hero{position:relative;isolation:isolate;min-height:235px;margin:19px 0 18px;overflow:hidden;border:1px solid #292f39;border-radius:9px;background:#080a0e url('/static/f1-car-hero.jpg') center right/cover no-repeat;display:flex;align-items:center;padding:27px clamp(20px,3vw,38px);box-shadow:inset 0 0 0 1px #ffffff03}
.car-hero:before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(5,7,10,.98) 0%,rgba(5,7,10,.91) 28%,rgba(5,7,10,.38) 57%,rgba(5,7,10,.1) 100%),linear-gradient(0deg,rgba(5,7,10,.55),transparent 45%)}
.car-hero:after{content:"";position:absolute;left:0;bottom:0;width:42%;height:3px;background:linear-gradient(90deg,var(--red),transparent)}
.car-hero-copy{position:relative;z-index:1;max-width:510px}.car-hero .section-kicker{font-size:10px;letter-spacing:2.8px;margin:0 0 10px}.car-hero h2{font-family:var(--display);font-size:clamp(34px,4.2vw,52px);line-height:.92;letter-spacing:1.2px;margin:0 0 12px;font-weight:800;text-shadow:0 2px 18px #0008}.car-hero h2 span{color:var(--red)}.car-hero-copy>p:not(.section-kicker){font-size:12px;line-height:1.6;color:#c4cbd4;margin:0}.hero-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:17px}.hero-tags span{font-size:8px;letter-spacing:.8px;color:#d2d7de;border:1px solid #ffffff26;background:#080b10a6;padding:7px 9px;border-radius:3px}.hero-tags i{display:inline-block;width:6px;height:6px;background:var(--green);border-radius:50%;margin-right:6px;box-shadow:0 0 9px #57d5a0}.hero-stamp{position:absolute;right:24px;bottom:20px;z-index:1;display:flex;flex-direction:column;align-items:flex-end;text-align:right;gap:5px;opacity:.92}.hero-stamp .stamp-slash{font-family:var(--display);font-size:29px;font-weight:800;font-style:italic;color:var(--red);line-height:1}.hero-stamp b{font-family:var(--display);font-size:16px;letter-spacing:1.2px}.hero-stamp small{font-size:8px;line-height:1.6;letter-spacing:1.7px;color:#c5ccd5}
@media(max-width:760px){.car-hero{min-height:255px;margin:14px 0;background-position:59% center;padding:24px 18px;align-items:flex-start}.car-hero:before{background:linear-gradient(90deg,rgba(5,7,10,.96),rgba(5,7,10,.74) 58%,rgba(5,7,10,.3)),linear-gradient(0deg,rgba(5,7,10,.5),transparent)}.car-hero h2{font-size:37px}.car-hero-copy>p:not(.section-kicker){font-size:11px}.hero-stamp{right:13px;bottom:12px}.hero-stamp .stamp-slash{font-size:20px}.hero-stamp b{font-size:11px}.hero-stamp small{font-size:7px}.desktop-break{display:none}}

/* V3 race engineer insights */
.insight-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:15px}
.insight-card{display:flex;align-items:center;gap:12px;min-width:0;padding:15px;background:linear-gradient(145deg,#121820,#0d1117);border:1px solid #252d37;border-radius:8px;box-shadow:inset 0 1px #ffffff05}
.insight-icon{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;flex-shrink:0;font-size:20px;font-weight:700;border:1px solid #313a46;background:#171d25;color:#cbd2dc}
.insight-icon.fastest{color:#57d5a0;border-color:#23523f;background:#10251e}.insight-icon.slowest{color:#ff5965;border-color:#54232b;background:#281318}.insight-icon.average{color:#f2c14e;border-color:#51431f;background:#211d10}.insight-icon.consistency{color:#9caeff;border-color:#303b64;background:#151a2c}
.insight-card div{display:flex;flex-direction:column;gap:4px;min-width:0}.insight-card small{font-size:8px;letter-spacing:1.2px;color:#8c96a4;font-weight:700}.insight-card strong{font-family:var(--display);font-size:22px;line-height:1.05;font-variant-numeric:tabular-nums}.insight-card span:last-child{font-size:9px;color:#818b98;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
@media(max-width:1050px){.insight-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:480px){.insight-grid{gap:8px}.insight-card{padding:11px 9px;gap:8px}.insight-icon{width:30px;height:30px;font-size:16px}.insight-card strong{font-size:18px}.insight-card small{font-size:7px}.insight-card span:last-child{font-size:8px}}

/* V4 cinematic game-mode polish — visual only, simulator logic unchanged */
:root{--red:#ff2638;--panel:#0d1219;--line:#29313d}
body{background:radial-gradient(ellipse at 72% -12%,#351018 0%,#101117 32%,#080a0e 68%);background-attachment:fixed}
.app-shell{background:linear-gradient(115deg,#090b0fef,#090b0fe8)}
.sidebar{background:linear-gradient(180deg,#0c0e13 0%,#101119 65%,#0a0c10 100%);box-shadow:12px 0 35px #0003}
.brand-mark{font-style:italic;text-shadow:0 0 22px #ff263822}
.nav-item{transition:background .18s,border-color .18s,transform .18s}
.nav-item:hover{background:#21151a;transform:translateX(2px)}
.nav-item.active{box-shadow:inset 3px 0 var(--red),0 0 22px #ff26380c;background:linear-gradient(90deg,#2a1219,#171217)}
.topbar{position:relative}
.topbar:after{content:"";position:absolute;bottom:-1px;left:0;width:30%;height:1px;background:linear-gradient(90deg,var(--red),transparent);box-shadow:0 0 12px #ff263877}
.car-hero{min-height:270px;border-color:#38313a;background-position:center 55%;box-shadow:0 15px 50px #0005,inset 0 0 0 1px #ffffff08;animation:heroReveal .65s ease-out both}
.car-hero:before{background:linear-gradient(90deg,rgba(4,6,9,.98) 0%,rgba(4,6,9,.87) 25%,rgba(4,6,9,.30) 58%,rgba(4,6,9,.04) 100%),linear-gradient(0deg,rgba(4,6,9,.7),transparent 48%)}
.car-hero:after{width:55%;height:3px;box-shadow:0 0 18px #ff263899}
.car-hero h2{font-size:clamp(38px,4.6vw,60px);letter-spacing:1.5px}
.hero-stamp{padding:12px 14px;border-right:2px solid var(--red);background:linear-gradient(90deg,transparent,#080a0b70);text-shadow:0 2px 12px #000}
.panel{background:linear-gradient(145deg,#121820f5,#0c1016f8);border-color:#29313c;box-shadow:0 8px 26px #0002,inset 0 1px #ffffff05;transition:border-color .2s,box-shadow .2s}
.panel:hover{border-color:#41404a;box-shadow:0 10px 32px #0003,inset 0 1px #ffffff08}
.panel-heading{border-bottom-color:#30313a}
.panel-index{text-shadow:0 0 13px #ff263833}
.primary-button{position:relative;overflow:hidden;background:linear-gradient(105deg,#ed1c2e,#ff3041 62%,#d90d21);box-shadow:0 7px 22px #f5223422,inset 0 1px #ffffff30;text-shadow:0 1px #0002}
.primary-button:before{content:"";position:absolute;top:-50%;left:-35%;height:200%;width:22%;transform:skewX(-22deg);background:linear-gradient(90deg,transparent,#ffffff2b,transparent);transition:left .5s}
.primary-button:hover:before{left:120%}
.primary-button:hover{box-shadow:0 9px 28px #ff26383b}
.tyre-choice{transition:border-color .18s,background .18s,transform .18s}
.tyre-choice:hover{border-color:#515966;background:#151a22;transform:translateX(2px)}
.stint{box-shadow:inset 0 1px #ffffff0b;transition:filter .2s,transform .2s}
.stint:hover{filter:brightness(1.12);transform:translateY(-1px)}
.stop-count{box-shadow:0 0 24px #ff26380b,inset 0 0 18px #ff263808}
.insight-card{position:relative;overflow:hidden;transition:transform .18s,border-color .18s}
.insight-card:after{content:"";position:absolute;left:0;top:0;width:2px;height:100%;background:var(--red);opacity:.7}
.insight-card:hover{transform:translateY(-2px);border-color:#434b57}
.insight-card strong{letter-spacing:.2px}
tbody tr{transition:background .15s}
tbody tr:hover{background:#1a2029}
tbody tr.best-row{background:linear-gradient(90deg,#3a1119aa,#17141b 65%);box-shadow:inset 2px 0 var(--red)}
.chart-wrap{height:205px}
footer{border-top:1px solid #242a32;margin-top:18px;padding-top:14px}
@keyframes heroReveal{from{opacity:.65;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
@media(max-width:760px){.car-hero{min-height:245px;background-position:61% center}.car-hero h2{font-size:38px}.chart-wrap{height:195px}}


/* V3 race-engineer polish: motion, depth and simulation feedback */
:root{--red-hot:#ff2638;--panel-glass:rgba(17,21,28,.92)}
body{background:radial-gradient(ellipse at 78% -10%,rgba(239,51,64,.075),transparent 38%),var(--bg)}
.panel{background:linear-gradient(145deg,rgba(19,24,32,.97),rgba(13,17,23,.98));border-color:#29313c;box-shadow:0 10px 32px rgba(0,0,0,.12);transition:border-color .22s ease,box-shadow .22s ease,transform .22s ease}
.panel:hover{border-color:#3a424f;box-shadow:0 14px 38px rgba(0,0,0,.2)}
.panel-heading{border-bottom-color:rgba(121,135,153,.19)}
.primary-button{position:relative;overflow:hidden;box-shadow:0 7px 24px rgba(239,51,64,.16)}
.primary-button:before{content:"";position:absolute;inset:0;transform:translateX(-120%);background:linear-gradient(100deg,transparent,rgba(255,255,255,.16),transparent);transition:transform .65s ease}
.primary-button:hover:before{transform:translateX(120%)}
.primary-button.is-running{background:linear-gradient(100deg,#9e1f2a,#ef3340,#9e1f2a);background-size:200% 100%;animation:buttonPulse 1.3s linear infinite}
.live-pill i,.status-dot{animation:statusPulse 2s ease-in-out infinite}
.car-hero{border-color:#343b47;box-shadow:0 18px 48px #0006,inset 0 0 0 1px #ffffff06}
.car-hero:after{animation:lineGlow 3s ease-in-out infinite}
.stint{transition:filter .2s ease,transform .2s ease;box-shadow:inset 0 1px rgba(255,255,255,.025)}
.stint:hover{filter:brightness(1.18);transform:translateY(-2px)}
.stop-count{box-shadow:0 0 25px rgba(239,51,64,.07),inset 0 0 18px rgba(239,51,64,.04)}
.insight-grid{gap:12px}
.insight-card{position:relative;overflow:hidden;background:linear-gradient(135deg,#141a22,#0f1319);border-color:#29313c;box-shadow:0 8px 25px #0002;transition:transform .2s ease,border-color .2s ease}
.insight-card:hover{transform:translateY(-3px);border-color:#424b59}
.insight-card:after{content:"";position:absolute;inset:0 auto 0 0;width:2px;background:linear-gradient(180deg,var(--red),transparent)}
.chart-panel{background:linear-gradient(145deg,#11161e,#0d1117)}
.chart-wrap canvas{filter:drop-shadow(0 0 5px rgba(239,51,64,.045))}
tbody tr{transition:background .18s ease}
tbody tr:hover{background:rgba(255,255,255,.035)}
tbody tr.best-row{background:linear-gradient(90deg,rgba(239,51,64,.13),rgba(239,51,64,.035))}
tbody tr.best-row td:first-child .rank{ text-shadow:0 0 15px rgba(239,51,64,.35)}
.gap-best{font-weight:800;letter-spacing:.5px}
.simulation-progress{margin-top:14px;padding:11px 12px;border:1px solid #34303a;border-radius:5px;background:linear-gradient(100deg,rgba(239,51,64,.08),rgba(17,21,28,.6));}
.progress-copy{display:flex;align-items:center;gap:8px;font-size:9px;color:#b9c2ce;letter-spacing:.25px}
.progress-copy strong{margin-left:auto;color:#ff6570;font-size:8px;letter-spacing:1px}
.progress-pulse{width:6px;height:6px;border-radius:50%;background:var(--red);box-shadow:0 0 10px #ef3340;flex:0 0 auto}
.is-active .progress-pulse{animation:statusPulse .8s infinite}
.progress-rail{height:3px;background:#2a303a;border-radius:4px;overflow:hidden;margin-top:10px}
.progress-rail span{display:block;width:38%;height:100%;background:linear-gradient(90deg,#a71f2b,#ff5260,#ff9a9f);box-shadow:0 0 12px rgba(239,51,64,.45);border-radius:4px}
.is-active .progress-rail span{animation:progressSweep 1.2s ease-in-out infinite}
.is-complete{border-color:#24513f;background:rgba(37,100,74,.09)}
.is-complete .progress-pulse{background:var(--green);box-shadow:0 0 10px var(--green)}
.is-complete .progress-copy strong{color:var(--green)}
.is-complete .progress-rail span{width:100%;background:var(--green);box-shadow:none;animation:none}
.is-error{border-color:#6a3037}
.is-error .progress-copy strong{color:#ff6570}
@keyframes progressSweep{0%{transform:translateX(-110%)}100%{transform:translateX(300%)}}
@keyframes statusPulse{0%,100%{opacity:1}50%{opacity:.42}}
@keyframes lineGlow{0%,100%{box-shadow:0 0 8px rgba(255,38,56,.15)}50%{box-shadow:0 0 18px rgba(255,38,56,.5)}}
@keyframes buttonPulse{to{background-position:200% 0}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}
@media(max-width:760px){.simulation-progress{padding:10px}.progress-copy{font-size:8px}.insight-grid{gap:8px}}
